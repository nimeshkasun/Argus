    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.10.2",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^10.2.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
