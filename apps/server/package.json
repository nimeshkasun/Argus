  "name": "@argus/server",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "node --env-file-if-exists=../../.env --watch-path=dist --watch-preserve-output dist/main.js",
