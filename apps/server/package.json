    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/semver": "^7.8.0",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.3",
    "smtp-server": "^3.21.1",
    "supertest": "^7.1.4",
    "testcontainers": "^12.2.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
