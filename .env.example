# Copy to .env and adjust. Full reference: docs/configuration.md

# --- Required ---------------------------------------------------------------
# postgres | mongodb. With docker compose, the compose file you choose sets the type.
ARGUS_DB_TYPE=postgres
# Database connection string.
# - Running from source (npm run dev): required; uncomment and point it at your database.
# - docker compose: leave it unset to use the bundled database container, or set it to use your own server,
#   e.g. one shared with another Argus instance (then also use the same ARGUS_MASTER_KEY as that instance).
#   Inside the container, "localhost" is the container itself: use host.docker.internal for a database on the host.
# ARGUS_DB_URL=postgres://argus:argus@localhost:5432/argus
# MongoDB only: database name (default "argus").
# ARGUS_DB_NAME=argus
# Root key for all encryption at rest and token signing. Generate with: openssl rand -base64 48
# Keep it secret and backed up: losing it makes stored credentials unrecoverable.
ARGUS_MASTER_KEY=
# Only for rotating the master key with the CLI (Argus stopped): node apps/server/dist/cli.js rotate-master-key
# Afterwards set ARGUS_MASTER_KEY to this value and remove this line. See docs/deployment/docker.md.
# ARGUS_NEW_MASTER_KEY=

# --- Optional ---------------------------------------------------------------
# MongoDB database name (defaults to the one in the URL, then "argus")
# ARGUS_DB_NAME=argus
# Initial password for the default "admin" account on a new database. If unset, one is generated and logged once.
# ARGUS_ADMIN_PASSWORD=
# External URL users browse to. https:// enables Secure cookies and HSTS. Links in emails (notifications, invites)
# use it, and sign-in links by email are only offered when it is set.
ARGUS_PUBLIC_URL=http://localhost:8080
ARGUS_API_URL=http://localhost:8080
# all | api | worker
ARGUS_ROLE=all
# LOG_LEVEL=info
PORT=8080
# Per-IP requests/minute on login, MFA and password endpoints (raise behind a shared corporate NAT)
# ARGUS_AUTH_RATE_LIMIT=10
# Enables Prometheus metrics at /metrics; scrapers send it as "Authorization: Bearer <token>". At least 16 characters.
# Generate with: openssl rand -base64 32
# ARGUS_METRICS_TOKEN=

# --- Scanning & background jobs --------------------------------------------
# Concurrent jobs (scans, source syncs) per worker process
# ARGUS_WORKER_CONCURRENCY=2
# Parent directory for temporary clones; each scan's folder is deleted when it ends
# ARGUS_SCAN_WORKDIR=/tmp/argus-scans
# Maximum time a git clone may take
# ARGUS_SCAN_TIMEOUT_MINUTES=30
# How often the scheduler looks for due scans and stale sources
# ARGUS_SCHEDULER_INTERVAL_SECONDS=30
# true = no outbound vulnerability/lifecycle lookups and no calls to AI providers' public APIs (air-gapped networks);
# secrets and certificate scans still run, and an AI provider with a private base URL keeps working
# ARGUS_OFFLINE=false
# false = this instance never runs repository scans (e.g. local development against a shared database). Scans
# that are due or requested stay queued until an instance with SCAN=true runs them.
# SCAN=true
# Internal mirrors for threat-intelligence sources (defaults are the public services)
# ARGUS_OSV_URL=https://api.osv.dev
# ARGUS_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# ARGUS_EPSS_URL=https://api.first.org/data/v1/epss
# ARGUS_EOL_URL=https://endoflife.date
# ARGUS_NPM_REGISTRY_URL=https://registry.npmjs.org
# ARGUS_NUGET_URL=https://api.nuget.org/v3-flatcontainer
# deps.dev API: latest version, deprecation and license of PyPI, Maven, Go and Cargo packages
# ARGUS_DEPSDEV_URL=https://api.deps.dev
# NVD CVE API 2.0, used for CVSS scores that OSV does not provide
# ARGUS_NVD_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# Optional NVD API key (free, https://nvd.nist.gov/developers/request-an-api-key): raises NVD's rate limit from 5 to 50 requests per 30 seconds
# ARGUS_NVD_API_KEY=
# Microsoft sovereign clouds (e.g. GCC High): Graph and Entra ID endpoints used for email
# ARGUS_GRAPH_URL=https://graph.microsoft.com
# ARGUS_ENTRA_LOGIN_URL=https://login.microsoftonline.com
# Gitleaks binary for the secrets scanner (bundled in the Docker image; built-in rules are used if it is missing)
# ARGUS_GITLEAKS_PATH=gitleaks
# Opengrep (or semgrep) for code analysis, and its rules folder; without rules, code analysis is skipped.
# The Docker image includes Opengrep and the community security rules (ARGUS_OPENGREP_RULES=/opt/argus/rules/opengrep).
# ARGUS_OPENGREP_PATH=opengrep
# ARGUS_OPENGREP_RULES=
# Trivy for infrastructure-as-code and container image scanning (bundled in the Docker image). Trivy's own TRIVY_*
# variables (e.g. TRIVY_USERNAME / TRIVY_PASSWORD for private registries) are passed through to it.
# Container image scanning itself is turned on under Administration -> Scanning settings.
# ARGUS_TRIVY_PATH=trivy

# --- AI assistance -----------------------------------------------------------
# No environment variables: providers (Claude, OpenAI, Gemini), API keys, models, budget and features are set
# in the app under Administration → AI assistance. Keys are stored encrypted with ARGUS_MASTER_KEY.

# --- Corporate network (optional) ------------------------------------------
# Outbound proxy for GitHub/Bitbucket, intel feeds and AI providers. git uses it directly; NODE_USE_ENV_PROXY=1 makes API calls use it too.
# AI hosts to allow (if enabled): api.anthropic.com, api.openai.com, generativelanguage.googleapis.com
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1
# NODE_USE_ENV_PROXY=1
# Private CA bundle for self-hosted GitHub Enterprise / Bitbucket Data Center (path inside the container)
# NODE_EXTRA_CA_CERTS=/certs/corp-ca.pem
# GIT_SSL_CAINFO=/certs/corp-ca.pem

# --- docker compose only ----------------------------------------------------
# POSTGRES_PASSWORD=argus-change-me
# MONGO_PASSWORD=argus-change-me
# ARGUS_HTTP_PORT=8080
